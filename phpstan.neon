parameters:
    level: 8
    paths:
        - src/
    excludePaths:
        - vendor/
        - tests/
        - src/Data/ExistingDatabaseManager.php
        # Standalone operational CLI scripts, not part of the library's API surface
        - src/Scripts/
    ignoreErrors:
        # Ignore some common issues that might be false positives
        - '#Call to an undefined method#'
        - '#Access to an undefined property#'
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
    reportUnmatchedIgnoredErrors: false
